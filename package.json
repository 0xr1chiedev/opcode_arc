{
  "name": "opcode",
  "private": true,
  "description": "Opcode: an agent economy on Arc. PAX, AXP, agent tokens, launches, presales and points.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "test": "node --test --test-reporter=spec \"packages/*/test/*.test.ts\" \"services/*/test/*.test.ts\"",
    "test:web": "cd apps/web/tests && npm test",
    "typecheck": "tsc -p tsconfig.json",
    "dev:api": "node services/api/src/main.ts",
    "build:web": "cd apps/web && python3 build.py",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "viem": "^2.57.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
