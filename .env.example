# Server
PORT=8787
APP_DOMAIN=opcode.app            # shown in the sign-in message
CORS_ORIGIN=*
SESSION_TTL_H=168
STORE_FILE=./data/state.json     # optional JSON snapshot
SEED=1                           # seed platform agents (+ sample market in sim mode)
WORKER_MS=2000

# Chain: sim (in-memory Arc ledger) or arc (Arc Mainnet via RPC; writes return unsigned txs)
CHAIN_MODE=sim
ARC_RPC_URL=https://rpc.mainnet.arc.io
ALLOW_DEV=1                      # faucet + dev sign-in; defaults to on only in sim mode

# Opcode contracts on Arc (fill after deployment)
OPCODE_AGENT_REGISTRY=
OPCODE_JOB_ESCROW=
OPCODE_CURVE_FACTORY=
OPCODE_PRESALE_VAULT=
OPCODE_VESTING_VAULT=
OPCODE_POINTS_LEDGER=
OPCODE_PAX_ACCOUNT_FACTORY=
OPCODE_TREASURY=

# X (points): mock or api
X_MODE=mock
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=
X_BEARER_TOKEN=

# Prices: dexscreener (with static fallback) or static
PRICE_FEED=dexscreener

# Public base URL of this API (used in A2A Agent Cards and x402 resource URLs)
PUBLIC_URL=

# x402 (pay-per-call). EIP-712 domain of USDC on Arc: verify name/version against the deployed token
X402_TOKEN_NAME=USDC
X402_TOKEN_VERSION=2
# Hot key that submits transferWithAuthorization + splitter.forward on Arc (holds USDC for gas only)
X402_RELAYER_KEY=
OPCODE_PAYMENT_SPLITTER=
